        },
        {
          "index": 1,
          "text": "[绞刑架]"
        }
      ]
    },
    {
      "key": "D5916",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[漆黑而猩红之物，猩红而漆黑之物。]"
        }
      ]
    },
    {
      "key": "D5917",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[启蒙时代]"
        }
      ]
    },
    {
      "key": "D5918",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[坠落的巨人]"
        },
        {
          "index": 2,
