        },
        {
          "index": 1,
          "text": "[断绝时代]"
        }
      ]
    },
    {
      "key": "D5921",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[金枝]"
        },
        {
          "index": 2,
          "text": "<……似乎是百货公司的过去。>",
          "speaker": "但丁"
        }
      ]
    },
    {
      "key": "D5922",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "什么也看不见。"
        }
      ]
    },
    {
      "key": "D5925",
      "texts": [
        {
          "index": 0,
          "text": "什么也看不见。"
        }
      ]
    },
    {
      "key": "D5926",
      "texts": [
        {
          "index": 0,
          "text": "什么也看不见。"
        }
      ]
    },
    {
      "key": "D5927",
      "texts": [
        {
          "index": 0,
          "text": "隐约能看到些什么。"
        },
        {
          "index": 1,
          "text": "[倾覆者们]"
        }
      ]
    },
    {
      "key": "D5928",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[曾浮起之物，终必沉沦。]"
        }
      ]
    },
    {
      "key": "D5929",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[华丽百货的最底层。令人作呕的沉积之物。]"
        }
      ]
    },
    {
      "key": "D5930",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[顺着解开的丝线走向出口，线头却已断裂。]"
        }
      ]
    },
    {
      "key": "D5931",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[无法攀登，亦无法抛掷，只能将线团缠了又缠。]"
        }
      ]
    },
    {
      "key": "D5932",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[抚摸着饱胀的腹部，叩击饥饿的精神。]"
        }
      ]
    },
    {
      "key": "D5933",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[已然抵达，却再也无法抵达的味。]"
        }
      ]
    },
    {
      "key": "D5934",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[擦肩而过的一切，皆轻易粉碎。]"
        }
      ]
    },
    {
      "key": "D5935",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[在褪色的角落里，只等待重返的刹那。]"
        }
      ]
    },
    {
      "key": "D5936",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[越是紧勒，权威便越会随之而来。]"
        }
      ]
    },
    {
      "key": "D5937",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般从巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[越是深陷于视线而无法自拔，随之而来的事物便越多。]"
        }
      ]
    },
    {
      "key": "D5938",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[无论对谁而言，信仰都是必要的。]"
        }
      ]
    },
    {
      "key": "D5939",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[敬畏之心大多已死，却从生者身上涌现。]"
        }
      ]
    },
    {
      "key": "D5940",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[无人能嘲笑瘫坐在地之人。]"
        }
      ]
    },
    {
      "key": "D5941",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[至少，选择瘫坐在地是自己亲手做出的。]"
        }
      ]
    },
    {
      "key": "D5942",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[哪怕紧捂着饥饿的肚子，精神也不会挨饿。]"
        }
      ]
    },
    {
      "key": "D5943",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[饥饿并非被填满，而是去填满。]"
        }
      ]
    },
    {
      "key": "D5944",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[每一步都将自己钉死。]"
        }
      ]
    },
    {
      "key": "D5945",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[巡礼之路的尽头，只剩下被钉死之人。]"
        }
      ]
    },
    {
      "key": "D5946",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[究竟为了什么而攀登。]"
        }
      ]
    },
    {
      "key": "D5947",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "[可最终却不得不走下去。]"
        }
      ]
    },
    {
      "key": "D5923",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        }
      ]
    },
    {
      "key": "D5924",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户涌入。"
        },
        {
          "index": 1,
          "text": "凝视良久，纹路开始荡漾起来。"
        },
        {
          "index": 2,
          "text": "<……这是。>",
          "speaker": "但丁"
        },
        {
          "index": 3,
          "text": "本不该出现的事物开始显现。"
        }
      ]
    },
    {
      "key": "D5948",
      "texts": [
        {
          "index": 0,
          "text": "代传神谕的副祭如今已卸下了那个职位。"
        }
      ]
    },
    {
      "key": "DDS501",
      "texts": [
        {
          "index": 0,
          "text": "……只有普伊独自留了下来。",
          "speaker": "默尔索"
        },
        {
          "index": 1,
          "text": "我们必须尽快返回餐厅，经理。",
          "speaker": "默尔索"
        }
      ]
    },
    {
      "key": "DDS502",
      "texts": [
        {
          "index": 0,
          "text": "<它追上我们了。准确地说……好像是追着普伊来的。>",
          "speaker": "但丁"
        },
        {
          "index": 1,
          "text": "推测其为黄金之茧，即被称为「尾虫」的实体的母体。",
          "speaker": "默尔索"
        },
        {
          "index": 2,
          "text": "<在清扫库存之前……听到哭声就找过来了。>",
          "speaker": "但丁"
        },
        {
          "index": 3,
          "text": "<…….>",
          "speaker": "但丁"
        },
        {
          "index": 4,
          "text": "<现在，先想想怎么打倒它吧。>",
          "speaker": "但丁"
        },
        {
          "index": 5,
          "text": "<布伊也在等着呢。>",
          "speaker": "但丁"
        },
        {
          "index": 6,
          "text": "嗯……每当天色暗下来时，那身影便会完全消失。仿佛从未存在过一般……",
          "speaker": "李箱"
        },
        {
          "index": 7,
          "text": "然后它突然就出现了。虽然体型巨大，但贴在地上的只有那类似尾巴的部分，连个合适的攻击部位都找不到……",
          "speaker": "格里高尔"
        },
        {
          "index": 8,
          "text": "黑暗并非巨大的妨碍要素。只要沉着冷静地行动，便能轻易避开。",
          "speaker": "默尔索"
        },
        {
          "index": 9,
          "text": "<……好，这次让我们更沉着冷静地战斗吧。>",
          "speaker": "但丁"
        }
      ]
    },
    {
      "key": "D5949",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户进入。"
        },
        {
          "index": 1,
          "text": "[顺应潮流，仅仅漂浮着的人们。]"
        }
      ]
    },
    {
      "key": "D5950",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户进入。"
        },
        {
          "index": 1,
          "text": "[用黑色布料将自己固定的人们。]"
        }
      ]
    },
    {
      "key": "D5951",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户进入。"
        },
        {
          "index": 1,
          "text": "[展露内在，固定外在的人们。]"
        }
      ]
    },
    {
      "key": "D5027",
      "texts": [
        {
          "index": 0,
          "text": "<color=#cf0000>百货公司的全体都听着。</color>"
        },
        {
          "index": 1,
          "text": "<color=#cf0000>布菲终于完成了，你们之中任何人都不会再挨饿……</color>"
        },
        {
          "index": 2,
          "text": "<color=#cf0000>我们，我，将吞噬百货公司的一切。</color>"
        },
        {
          "index": 3,
          "text": "<color=#cf0000>不要再等待，不要再呼喊，不要再……渴求。</color>"
        },
        {
          "index": 4,
          "text": "<color=#cf0000>撕咬并吞咽吧。将眼前所见之物吞噬殆尽。</color>"
        },
        {
          "index": 5,
          "text": "<color=#cf0000>全体上到5层，去捕食他们隐藏的珍馐吧。</color>"
        },
        {
          "index": 6,
          "text": "<color=#cf0000>把食物端上来。</color>"
        },
        {
          "index": 7,
          "text": "<color=#cf0000>黑派也好，勒卡基也好，红派也好……美妆馆的梳妆台，奢侈品馆的大理石，广播室的喇叭和家具馆的灯火。美食广场的屠夫和染色室的脓液。被冲上海滩的尸体和被丢弃的皮革。甚至连填补裂缝的黄金皮革也是。</color>"
        },
        {
          "index": 8,
          "text": "<color=#cf0000>把这一切都端到我面前，然后把这一切都吃掉吧。</color>"
        }
      ]
    },
    {
      "key": "D5028",
      "texts": [
        {
          "index": 0,
          "text": "……现在不再前进也没关系了吗。",
          "speaker": "默尔索"
        },
        {
          "index": 1,
          "text": "在这里就能将一切填满。饿了便吃，渴了便饮。",
          "speaker": "布菲"
        },
        {
          "index": 2,
          "text": "那样的话……想要前往某处的心，应该是没有空间容身了吧。",
          "speaker": "布菲"
        }
      ]
    },
    {
      "key": "D5029",
      "texts": [
        {
          "index": 0,
          "text": "在巨大的餐桌上环顾四周，但我们终究没能找到上到6层的方法。"
        },
        {
          "index": 1,
          "text": "因此……我们决定坐在一旁，注视着布菲的进食。"
        }
      ]
    },
    {
      "key": "D5030",
      "texts": [
        {
          "index": 0,
          "text": "咔嚓。"
        },
        {
          "index": 1,
          "text": "布菲吞下的是放在盘子上的一片面包。"
        },
        {
          "index": 2,
          "text": "接下来是流淌着肉汁的牛排……"
        },
        {
          "index": 3,
          "text": "再然后，装饰得整整齐齐的巨大蛋糕也毫无痕迹地消失在布菲的口中。"
        },
        {
          "index": 4,
          "text": "在那之后……已经无法分辨布菲在咀嚼什么，在吃什么了。"
        },
        {
          "index": 5,
          "text": "盘子。勺子和刀，还有桌布……毫无分别地狼吞虎咽着进入布菲的口中。"
        },
        {
          "index": 6,
          "text": "还没把咀嚼的东西咽下去……自助餐的手就已经紧攥住了下一个东西。"
        },
        {
          "index": 7,
          "text": "仿佛连为了感受味道而进行的刹那等待也是一种奢侈。"
        }
      ]
    },
    {
      "key": "D5500",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户照入。"
        },
        {
          "index": 1,
          "text": "能看到无边无际的广场，以及矗立在中央的巨大建筑。无数人群在其中穿梭往来。"
        }
      ]
    },
    {
      "key": "D5501",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户照入。"
        },
        {
          "index": 1,
          "text": "在令人窒息的黑暗通道间，微弱的光芒摇曳。周围堆满了罐头，能看到人群在宛如洞穴般的狭窄通道中穿梭往来。"
        }
      ]
    },
    {
      "key": "D5502",
      "texts": [
        {
          "index": 0,
          "text": "光芒如倾泻般透过巨大的窗户照入。"
        },
        {
          "index": 1,
          "text": "人群正朝着彼此不停地呼喊。不知道在喊些什么……那模样简直就像是一场审判。"
        }
      ]
    }
  ]
}
